# Copy this file to .env.local and fill in the value.
# Google Apps Script Web App URL that receives demo request submissions.
NEXT_PUBLIC_SHEETS_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# FastAPI auth server base URL (the server in ./server, exposed via cloudflared).
# Local dev: http://127.0.0.1:8000 — Production: your cloudflared hostname.
NEXT_PUBLIC_AUTH_URL=http://127.0.0.1:8000

# Gammal Tech Web SDK script URL for client-side payments. Confirm with
# dev@gammal.tech - payments require pre-approval + a whitelisted callback page.
NEXT_PUBLIC_GAMMAL_SDK_URL=https://api.gammal.tech/sdk-web.js

