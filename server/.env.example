# Copy to server/.env and fill in. Never commit the real .env.

# Generate a strong secret, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# How long issued JWTs stay valid (minutes). Default 1 day.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite file path (relative to where uvicorn runs).
DATABASE_URL=sqlite:///./auth.db

# Browser origins allowed to call the API (comma-separated).
# Add your cloudflared hostname for the FRONTEND, and local dev origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://truebex.com,https://www.truebex.com

# Public URLs, used to build payment redirect and webhook URLs.
SITE_URL=https://truebex.com
API_URL=https://api.truebex.com

# --- Google Sign-In -----------------------------------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web).
# Authorized JavaScript origins: https://truebex.com, https://www.truebex.com,
# http://localhost:3000. Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=

# --- Stripe (card subscriptions) — leave empty to disable -------------------------
# Secret key (sk_live_... / sk_test_...), the webhook signing secret for the
# endpoint https://api.truebex.com/billing/webhooks/stripe (events:
# checkout.session.completed, customer.subscription.created/updated/deleted),
# and the Price id of the monthly Pro price.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# --- Wayl (Iraq: QiCard, FIB, ZainCash) — leave empty to disable ------------------
# Merchant key from the Wayl dashboard (or jisr@wayl.io). WAYL_WEBHOOK_SECRET is
# any random string of 10-255 chars; Wayl echoes it on webhooks.
WAYL_API_KEY=
WAYL_WEBHOOK_SECRET=
WAYL_ENV=live
# Price of one 30-day Pro period in IQD (minimum 1000).
WAYL_PRICE_PRO_IQD=130000

# --- Licence API (desktop app sign-in, entitlements, release feed) --------------
# Make keys with:  .venv\Scripts\python.exe scripts\make_signing_key.py --kind lic|rel
# The lic-* seed signs entitlements and lives only here. Empty switches
# activation, entitlements and trials off (503).
LICENCE_SIGNING_KEY=
LICENCE_KEY_ID=lic-2026-10
# Public halves of the rel-* keys ("kid:key,kid:key"). The rel-* SEEDS never
# go on this host: publish_release.py reads them from a file you keep elsewhere.
RELEASE_PUBLIC_KEYS=
# Older lic-* public keys still accepted during a rotation ("kid:key,...").
SIGNING_KEYS_EXTRA=
TRIAL_DAYS=14

# --- Storage and background jobs ---------------------------------------------------
# local = files under STORAGE_DIR, downloaded through signed /files URLs on
# API_URL (set API_URL=http://127.0.0.1:8000 for a local test).
STORAGE_BACKEND=local
STORAGE_DIR=./storage
# HMAC key for signed file URLs; empty derives one from SECRET_KEY.
STORAGE_URL_SECRET=
# inline | worker | off
BACKGROUND_TASKS=inline

# --- Marketplace (PF7, contract marketplace-api) ---------------------------------
# Card payments for orders (Stripe Checkout + Connect transfers to suppliers).
# Keep false until GD5 signs off the marketplace terms: every supplier is then
# quote-only and buyers send requests for quote.
MARKET_PAYMENTS_ENABLED=false
# Signing secret(s) of the Stripe webhook endpoint for
# https://api.truebex.com/market/webhooks/stripe (events: checkout.session.completed,
# checkout.session.async_payment_succeeded, account.updated), "whsec_a,whsec_b".
# Uses STRIPE_SECRET_KEY above. Empty disables the endpoint (404).
STRIPE_CONNECT_WEBHOOK_SECRET=
# Anonymous catalogue reads per address per minute (429 rate_limited beyond).
MARKET_READS_PER_MINUTE=120
# Picture search: empty (off), stub (local trials) or clip-vit-b32 after
#   .venv\Scripts\python.exe scripts\fetch_models.py
EMBEDDING_MODEL=
EMBEDDING_DIR=./models

# --- Mail (PF14 Plumbing; first user PF8) -----------------------------------------
# console = printed in the API console and kept in memory (the home PC);
# smtp arrives with PF14 (SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD).
MAIL_BACKEND=console
MAIL_FROM=Truebex <hello@truebex.com>
SUPPORT_EMAIL=hello@truebex.com

# --- Supplier portal (PF8) --------------------------------------------------------
# Registered feed URLs (contract 5.12) are read once a day at this UTC hour.
FEED_PULL_HOUR_UTC=2
