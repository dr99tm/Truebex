# Copy to server/.env and fill in. Never commit the real .env.

# Generate a strong secret, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# How long issued JWTs stay valid (minutes). Default 1 day.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite file path (relative to where uvicorn runs).
DATABASE_URL=sqlite:///./auth.db

# Browser origins allowed to call the API (comma-separated).
# Add your cloudflared hostname for the FRONTEND, and local dev origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://truebex.com,https://www.truebex.com

# Public URLs, used to build payment redirect and webhook URLs.
SITE_URL=https://truebex.com
API_URL=https://api.truebex.com

# --- Google Sign-In -----------------------------------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web).
# Authorized JavaScript origins: https://truebex.com, https://www.truebex.com,
# http://localhost:3000. Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=

# --- Billing (PF2) -----------------------------------------------------------------
# The provider checkout uses: paddle (reseller / Merchant of Record, default) or
# stripe. Prices come from app/catalogue.json; after any change run
#   .venv\Scripts\python.exe scripts\sync_prices.py --provider paddle --env sandbox
BILLING_PROVIDER=paddle
# Background jobs (BACKGROUND_TASKS) are set under "Operations (PF14)".

# --- Paddle — leave the API key empty to disable --------------------------------------
# sandbox or production. The API key and the client-side token come from
# Developer tools > Authentication; the webhook secret from the notification
# destination https://api.truebex.com/billing/webhooks/paddle (events
# subscription.* and transaction.*). The client token is public (served to
# Paddle.js on /checkout/ by /config).
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_CLIENT_TOKEN=
# Local mock instead of Paddle (server/tests/mock_paddle.py), e.g.
# PADDLE_API_BASE=http://127.0.0.1:8098 with PADDLE_WEBHOOK_SECRET=pdl_ntfset_mock_secret
PADDLE_API_BASE=

# --- Stripe (business invoices; checkout when BILLING_PROVIDER=stripe) — leave empty to disable
# Secret key (sk_live_... / sk_test_...) and the webhook signing secret for the
# endpoint https://api.truebex.com/billing/webhooks/stripe (events:
# checkout.session.completed, checkout.session.expired,
# customer.subscription.created/updated/deleted/paused/resumed).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The original monthly Pro price id: existing subscribers on it keep Pro.
STRIPE_PRICE_PRO=
# Stripe Tax (automatic_tax on Checkout and invoices).
STRIPE_TAX_ENABLED=false

# --- Wayl (dormant: retired from the site) --------------------------------------------
# Off unless WAYL_ENABLED=true AND the keys are set; never offered on the site.
WAYL_ENABLED=false
WAYL_API_KEY=
WAYL_WEBHOOK_SECRET=
WAYL_ENV=live
# Price of one 30-day Pro period in IQD (minimum 1000).
WAYL_PRICE_PRO_IQD=130000

# --- Licence API (desktop app sign-in, entitlements, release feed) --------------
# Make keys with:  .venv\Scripts\python.exe scripts\make_signing_key.py --kind lic|rel
# The lic-* seed signs entitlements and lives only here. Empty switches
# activation, entitlements and trials off (503).
LICENCE_SIGNING_KEY=
LICENCE_KEY_ID=lic-2026-10
# Public halves of the rel-* keys ("kid:key,kid:key"). The rel-* SEEDS never
# go on this host: publish_release.py reads them from a file you keep elsewhere.
RELEASE_PUBLIC_KEYS=
# Older lic-* public keys still accepted during a rotation ("kid:key,...").
SIGNING_KEYS_EXTRA=
TRIAL_DAYS=14

# --- Operations (PF14). Defaults suit local development; the VM's values are
# in infra/secrets/server.env.example. -----------------------------------------
# Production: postgresql+psycopg://truebex:<password>@postgres:5432/truebex
# DATABASE_URL above stays SQLite locally.

# Blob storage: local (files under STORAGE_DIR, downloaded through signed
# /files URLs on API_URL; set API_URL=http://127.0.0.1:8000 for a local test)
# or s3 (S3-compatible bucket).
STORAGE_BACKEND=local
STORAGE_DIR=./storage
# HMAC key for signed /files URLs; empty derives one from SECRET_KEY.
STORAGE_URL_SECRET=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CDN_BASE_URL=

# Mail: console (printed and kept in memory) or smtp (the provider's relay).
MAIL_BACKEND=console
MAIL_FROM=Truebex <hello@truebex.com>
SUPPORT_EMAIL=hello@truebex.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Background jobs (telemetry rollup and retention, crash symbolication, link
# purge, device lapse, founding holds, daily billing reconcile, backup checks,
# floating-seat lease and invite expiry, SSO request and audit purges):
# inline (inside this process), worker (python -m app.worker) or off.
BACKGROUND_TASKS=inline
# Rate limiter buckets: memory (one process) or db (several processes).
RATELIMIT_BACKEND=memory

# Alerts from the API's own checks (backups): e-mail and an ntfy-style push URL.
ALERT_EMAIL=
ALERT_PUSH_URL=
BACKUP_EXPECTED=false

# Telemetry (contracts/telemetry.md): the events kill switch and ingestion as a whole.
TELEMETRY_EVENTS_ENABLED=true
TELEMETRY_INGESTION_ENABLED=true
MINIDUMP_STACKWALK=minidump-stackwalk

# --- Organisations and SSO -------------------------------------------------------------
# Fernet key sealing SSO client secrets. Make one with:
#   .venv\Scripts\python.exe -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Empty derives one from SECRET_KEY (then changing SECRET_KEY means re-entering SSO secrets).
SSO_SECRET_KEY=
# SAML entity id of this service. Empty: each organisation's metadata URL
# ({API_URL}/auth/sso/saml/<slug>/metadata).
SAML_SP_ENTITY_ID=
# How long the audit log keeps organisation events (24 months).
AUDIT_RETENTION_DAYS=730

# --- Share pages (PF5) -----------------------------------------------------------
# Share links are ${SHARE_BASE_URL}/view/{slug}; empty = API_URL. The page loads
# the viewer from ${SITE_URL}/viewer/viewer.js, so for a phone on the LAN set
# SITE_URL to the served out/ (http://<LAN address>:31NN) and API_URL to
# http://<LAN address>:8000 (signed file URLs use API_URL too).
SHARE_BASE_URL=
# Longest expiry (days) and bytes per bundle until the plan matrix sets them.
SHARE_MAX_DAYS=30
SHARE_MAX_BYTES=1073741824
