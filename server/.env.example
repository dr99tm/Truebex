# Copy to server/.env and fill in. Never commit the real .env.

# Generate a strong secret, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# How long issued JWTs stay valid (minutes). Default 1 day.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite file path (relative to where uvicorn runs).
DATABASE_URL=sqlite:///./auth.db

# Browser origins allowed to call the API (comma-separated).
# Add your cloudflared hostname for the FRONTEND, and local dev origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://truebex.com,https://www.truebex.com

# Public URLs, used to build payment redirect and webhook URLs.
SITE_URL=https://truebex.com
API_URL=https://api.truebex.com

# --- Google Sign-In -----------------------------------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web).
# Authorized JavaScript origins: https://truebex.com, https://www.truebex.com,
# http://localhost:3000. Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=

# --- Billing (PF2) -----------------------------------------------------------------
# The provider checkout uses: paddle (reseller / Merchant of Record, default) or
# stripe. Prices come from app/catalogue.json; after any change run
#   .venv\Scripts\python.exe scripts\sync_prices.py --provider paddle --env sandbox
BILLING_PROVIDER=paddle
# Background jobs (BACKGROUND_TASKS) are set under "Storage and background jobs".

# --- Paddle — leave the API key empty to disable --------------------------------------
# sandbox or production. The API key and the client-side token come from
# Developer tools > Authentication; the webhook secret from the notification
# destination https://api.truebex.com/billing/webhooks/paddle (events
# subscription.* and transaction.*). The client token is public (served to
# Paddle.js on /checkout/ by /config).
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_CLIENT_TOKEN=
# Local mock instead of Paddle (server/tests/mock_paddle.py), e.g.
# PADDLE_API_BASE=http://127.0.0.1:8098 with PADDLE_WEBHOOK_SECRET=pdl_ntfset_mock_secret
PADDLE_API_BASE=

# --- Stripe (business invoices; checkout when BILLING_PROVIDER=stripe) — leave empty to disable
# Secret key (sk_live_... / sk_test_...) and the webhook signing secret for the
# endpoint https://api.truebex.com/billing/webhooks/stripe (events:
# checkout.session.completed, checkout.session.expired,
# customer.subscription.created/updated/deleted/paused/resumed).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The original monthly Pro price id: existing subscribers on it keep Pro.
STRIPE_PRICE_PRO=
# Stripe Tax (automatic_tax on Checkout and invoices).
STRIPE_TAX_ENABLED=false

# --- Wayl (dormant: retired from the site) --------------------------------------------
# Off unless WAYL_ENABLED=true AND the keys are set; never offered on the site.
WAYL_ENABLED=false
WAYL_API_KEY=
WAYL_WEBHOOK_SECRET=
WAYL_ENV=live
# Price of one 30-day Pro period in IQD (minimum 1000).
WAYL_PRICE_PRO_IQD=130000

# --- Subscription consumer rules (PF2b; guides/GD5 §7) — all OFF until the solicitor signs off
# UK DMCC Act 2024: renewal reminders, the trial-end notice and the renewal
# cooling-off refund (QS-18). Nothing is sent before SUBSCRIPTION_RULES_FROM.
SUBSCRIPTION_NOTICES_ENABLED=false
SUBSCRIPTION_RULES_FROM=2027-01-01
# Reminder lead times in days (GD5 names none).
RENEWAL_REMINDER_DAYS_YEAR=14
RENEWAL_REMINDER_DAYS_MONTH=3
TRIAL_END_NOTICE_DAYS=3
# The EU withdrawal function, Directive 2011/83/EU Art. 11a (QS-18).
EU_WITHDRAWAL_ENABLED=false
# GD5 §7.4 wording approved (QS-17). Build the site with
# NEXT_PUBLIC_LEGAL_WORDING_APPROVED=true at the same time, or checkout shows
# "being set up".
LEGAL_WORDING_APPROVED=false
# QS-17: digital_content (consent ends the right to cancel) or service (the
# customer pays for the days used).
CONSENT_VARIANT=digital_content
# The registered office for the order confirmation (QS-2); the EULA page once
# published (empty = the terms page).
COMPANY_ADDRESS=
EULA_URL=
# Webhooks: Paddle needs no new events (transaction.* carries renewals); add
# invoice.paid to Stripe's endpoint (a renewal opens the cooling-off).

# --- Licence API (desktop app sign-in, entitlements, release feed) --------------
# Make keys with:  .venv\Scripts\python.exe scripts\make_signing_key.py --kind lic|rel
# The lic-* seed signs entitlements and lives only here. Empty switches
# activation, entitlements and trials off (503).
LICENCE_SIGNING_KEY=
LICENCE_KEY_ID=lic-2026-10
# Public halves of the rel-* keys ("kid:key,kid:key"). The rel-* SEEDS never
# go on this host: publish_release.py reads them from a file you keep elsewhere.
RELEASE_PUBLIC_KEYS=
# Older lic-* public keys still accepted during a rotation ("kid:key,...").
SIGNING_KEYS_EXTRA=
TRIAL_DAYS=14

# --- Storage and background jobs ---------------------------------------------------
# local = files under STORAGE_DIR, downloaded through signed /files URLs on
# API_URL (set API_URL=http://127.0.0.1:8000 for a local test).
STORAGE_BACKEND=local
STORAGE_DIR=./storage
# HMAC key for signed file URLs; empty derives one from SECRET_KEY.
STORAGE_URL_SECRET=
# Background jobs (link purge, device lapse, founding holds, daily billing
# reconcile): inline | worker | off
BACKGROUND_TASKS=inline
