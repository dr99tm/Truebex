{
  "name": "@truebex/sdk",
  "version": "1.1.0",
  "description": "The Truebex developer API: projects, exports, shares, the marketplace, supplier feeds and webhooks.",
  "type": "module",
  "main": "./src/index.mjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": { "types": "./src/index.d.ts", "default": "./src/index.mjs" },
    "./webhooks": { "types": "./src/webhooks.d.ts", "default": "./src/webhooks.mjs" }
  },
  "files": ["src", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "sideEffects": false,
  "license": "MIT",
  "homepage": "https://truebex.com/developers/sdks/",
  "keywords": ["truebex", "api", "sdk", "webhooks"]
}
