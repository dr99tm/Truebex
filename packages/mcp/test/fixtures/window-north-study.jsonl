{"comment": "agent-interface.md 9 -- the acceptance line: put a window on the north wall of the study, 1.2 m wide (the demo building, Riverside Court)"}
{"setup": "demo-building"}
{"prompt": "allow-edit"}
{"send": {"op": "hello", "wire": "truebex-agent-wire/1", "token": "${token}", "client": {"name": "stub", "version": "1.0.0"}, "era": "2026-07-28"}, "expect": {"op": "hello", "ok": true, "grants": [], "session": "*", "toolsHash": "*", "app": {"name": "Truebex"}}}
{"send": {"op": "call", "tool": "find", "args": {"kind": "wall", "room": "Study", "facing": "n"}}, "expect": {"op": "result", "ok": true, "isError": false, "structured": {"ok": true, "total": 1}}, "capture": {"wall": "structured.matches.0.ref"}}
{"send": {"op": "call", "tool": "place", "args": {"kind": "window", "host": "${wall}", "width_mm": 1200}}, "expect": {"op": "result", "ok": true, "structured": {"ok": true, "width_mm": 1200, "created": ["*"], "changed": ["${wall}"], "undo_step": "*"}}, "capture": {"window": "structured.created.0"}}
{"send": {"op": "call", "tool": "explain", "args": {"ref": "${window}"}}, "expect": {"op": "result", "ok": true, "structured": {"kind": "window", "properties": {"width_mm": 1200}}}}
{"send": {"op": "call", "tool": "read_state", "args": {}}, "expect": {"op": "result", "ok": true, "structured": {"schema": "truebex-agent-state/1", "digest": "*"}}}
{"send": {"op": "call", "tool": "undo", "args": {}}, "expect": {"op": "result", "ok": true, "structured": {"ok": true, "undone": ["*"]}}}
{"send": {"op": "call", "tool": "undo", "args": {}}, "expect": {"op": "result", "ok": false, "isError": true, "structured": {"code": "not_top"}}}
{"setup": "new-document"}
