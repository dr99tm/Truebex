# Postgres and wal-g. Template only: no real values here.
POSTGRES_USER=truebex
POSTGRES_PASSWORD=
POSTGRES_DB=truebex

# wal-g: the backup bucket at the second provider (its own key: write here only)
WALG_S3_PREFIX=s3://truebex-db-backups/pg
AWS_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
AWS_REGION=eu-central-003
AWS_S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Client-side encryption of every backup: 32 random bytes as hex
# (python -c "import secrets; print(secrets.token_hex(32))"). Without it no backup can be read.
WALG_LIBSODIUM_KEY=
WALG_LIBSODIUM_KEY_TRANSFORM=hex
WALG_COMPRESSION_METHOD=zstd
PGHOST=/var/run/postgresql
