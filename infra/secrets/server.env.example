# The API and worker (server/app/config.py). Template only: no real values here.
SECRET_KEY=
DATABASE_URL=postgresql+psycopg://truebex:<POSTGRES_PASSWORD>@postgres:5432/truebex
CORS_ORIGINS=https://truebex.com,https://www.truebex.com
SITE_URL=https://truebex.com
API_URL=https://api.truebex.com

GOOGLE_CLIENT_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
WAYL_API_KEY=
WAYL_WEBHOOK_SECRET=
WAYL_ENV=live
WAYL_PRICE_PRO_IQD=130000

# Object storage (the data bucket; its own key: read/write on this bucket only)
STORAGE_BACKEND=s3
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_REGION=fsn1
S3_BUCKET=truebex-data
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CDN_BASE_URL=

# Mail (the provider's SMTP relay; SPF / DKIM / DMARC in infra/tofu)
MAIL_BACKEND=smtp
MAIL_FROM=Truebex <hello@truebex.com>
SUPPORT_EMAIL=hello@truebex.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Alerts from the API's own checks (backups)
ALERT_EMAIL=hello@truebex.com
ALERT_PUSH_URL=

TELEMETRY_EVENTS_ENABLED=true
TELEMETRY_INGESTION_ENABLED=true
