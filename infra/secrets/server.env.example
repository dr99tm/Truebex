# The API and worker (server/app/config.py). Template only: no real values here.
SECRET_KEY=
DATABASE_URL=postgresql+psycopg://truebex:<POSTGRES_PASSWORD>@postgres:5432/truebex
CORS_ORIGINS=https://truebex.com,https://www.truebex.com
SITE_URL=https://truebex.com
API_URL=https://api.truebex.com

GOOGLE_CLIENT_ID=

# Billing (PF2; server/.env.example explains each). Paddle is the default
# provider; Stripe keeps business invoices; Wayl is dormant.
BILLING_PROVIDER=paddle
PADDLE_ENV=production
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_CLIENT_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_TAX_ENABLED=false
WAYL_ENABLED=false
WAYL_API_KEY=
WAYL_WEBHOOK_SECRET=
WAYL_ENV=live
WAYL_PRICE_PRO_IQD=130000

# Licence API (PF1). The lic-* seed that signs entitlements (empty = the
# licence API answers 503). Only the PUBLIC halves of the rel-* keys: their
# seeds never reach the VM (publish_release.py --key-file, kept elsewhere).
LICENCE_SIGNING_KEY=
LICENCE_KEY_ID=lic-2026-10
RELEASE_PUBLIC_KEYS=
SIGNING_KEYS_EXTRA=
TRIAL_DAYS=14

# Subscription consumer rules (PF2b; server/.env.example explains each). All
# off until the solicitor approves GD5 §7; LEGAL_WORDING_APPROVED goes on with
# a site build made with NEXT_PUBLIC_LEGAL_WORDING_APPROVED=true.
SUBSCRIPTION_NOTICES_ENABLED=false
SUBSCRIPTION_RULES_FROM=2027-01-01
EU_WITHDRAWAL_ENABLED=false
LEGAL_WORDING_APPROVED=false
CONSENT_VARIANT=digital_content
COMPANY_ADDRESS=
EULA_URL=

# Organisations and SSO (PF3; server/.env.example explains each). SSO_SECRET_KEY
# is a Fernet key sealing the organisations' SSO client secrets: set it once and
# keep it (empty derives one from SECRET_KEY, so rotating SECRET_KEY would make
# every organisation re-enter its secret).
SSO_SECRET_KEY=
SAML_SP_ENTITY_ID=
AUDIT_RETENTION_DAYS=730

# Share pages (PF5). Empty SHARE_BASE_URL = links on API_URL (/view/{slug}).
SHARE_BASE_URL=
SHARE_MAX_DAYS=30
SHARE_MAX_BYTES=1073741824

# Marketplace (PF7). Card payments stay off until GD5 signs off the marketplace
# terms; the Connect webhook secret is the /market/webhooks/stripe endpoint's.
MARKET_PAYMENTS_ENABLED=false
STRIPE_CONNECT_WEBHOOK_SECRET=
MARKET_READS_PER_MINUTE=120
# Picture search (PF7a): clip-vit-b32 once its files are in the `models` volume
# (deploy skill, API). EMBEDDING_DIR is set by compose.yaml (/app/models).
EMBEDDING_MODEL=

# Object storage (the data bucket; its own key: read/write on this bucket only)
STORAGE_BACKEND=s3
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_REGION=fsn1
S3_BUCKET=truebex-data
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CDN_BASE_URL=

# Mail (the provider's SMTP relay; SPF / DKIM / DMARC in infra/tofu)
MAIL_BACKEND=smtp
MAIL_FROM=Truebex <hello@truebex.com>
SUPPORT_EMAIL=hello@truebex.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Alerts from the API's own checks (backups)
ALERT_EMAIL=hello@truebex.com
ALERT_PUSH_URL=

TELEMETRY_EVENTS_ENABLED=true
TELEMETRY_INGESTION_ENABLED=true

# Cloud render orchestration (PF6): tiles from CDN_BASE_URL/tiles when empty.
TILES_BASE_URL=
CU_CLASS_WEIGHTS=gpu-std:1.0,cpu-8:0.25,gpu-ai:0.85
RENDER_POOL=static
RENDER_POOL_MIN=0
RENDER_POOL_MAX=4

# Analysis and AI services (PF11): the AI proxy's provider key (only here),
# the self-hosted inference servers' key, the texture kind's switch.
ANTHROPIC_API_KEY=
SELFHOSTED_API_KEY=
AI_TEXTURE_ENABLED=false

# Public API and webhooks (PF12): the Fernet key sealing webhook signing secrets
# (set once and keep it; empty = derived from SECRET_KEY). The burst limit per key.
WEBHOOK_SECRET_KEY=
API_KEY_BURST=60
API_KEY_PER_MINUTE=600

# Support API: the secret the Truebex Desk signs /internal/support calls with
# (the same value as the Worker's SUPPORT_SERVICE_SECRET; empty = those routes 404).
SUPPORT_SERVICE_SECRET=

# Outbound requests (PF14b): OpenID Connect issuers on private addresses stay
# refused on the VM (local testing only).
SSO_ALLOW_PRIVATE_ISSUERS=false
